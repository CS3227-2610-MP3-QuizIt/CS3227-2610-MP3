ENVIRONMENT=development
DATABASE_PATH=private/development.sqlite3
STORAGE_PATH=private/notes
ALLOWED_ORIGINS=["http://localhost:5173"]

# Gateway origin; /v1/responses is appended by the backend.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg
SOCLAAS_API_KEY=

# Configure three DISTINCT permitted text model IDs and verified context limits.
# Empty values keep ordinary workflows available and disable fresh AI requests.
SOCLAAS_HINT_MODEL=
SOCLAAS_QUIZ_MODEL=
SOCLAAS_SUMMARY_MODEL=
SOCLAAS_HINT_CONTEXT_TOKENS=0
SOCLAAS_QUIZ_CONTEXT_TOKENS=0
SOCLAAS_SUMMARY_CONTEXT_TOKENS=0
