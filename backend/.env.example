ENVIRONMENT=development
DATABASE_PATH=private/development.sqlite3
STORAGE_PATH=private/notes
ALLOWED_ORIGINS=["*"]

# Gateway origin; /v1/responses is appended by the backend.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg
SOCLAAS_API_KEY=

# Configure a permitted text model ID and verified context limit for each feature.
# Any two or all three features may use the same model ID.
# Empty values keep ordinary workflows available and disable fresh AI requests.
SOCLAAS_HINT_MODEL=qwen3.6:35b
SOCLAAS_QUIZ_MODEL=qwen3.8:27b
SOCLAAS_SUMMARY_MODEL=qwen3.5:9b
SOCLAAS_HINT_CONTEXT_TOKENS=8192
SOCLAAS_QUIZ_CONTEXT_TOKENS=32768
SOCLAAS_SUMMARY_CONTEXT_TOKENS=8192
